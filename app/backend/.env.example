# Application Settings
APP_NAME="SafeLabel AI API"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Server IP & CORS Origins
SERVER_IP=127.0.0.1
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://safelabel:safelabel@localhost:5432/safelabel

# Authentication & Security
JWT_SECRET=your-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=10485760

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=SafeLabel AI <onboarding@resend.dev>

# Translation Service (DeepL)
DEEPL_API_KEY=your_deepl_api_key_here

# Open Food Facts API
OFF_BASE_URL=https://world.openfoodfacts.org/api/v2/product
OFF_USER_AGENT=SafeLabelAI/1.0 (https://github.com/safelabel-ai)
